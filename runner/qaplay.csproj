<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>qaplay</AssemblyName>
    <RootNamespace>Qaplay.Runner</RootNamespace>
    <Version>0.1.0</Version>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <!-- 규칙을 읽고, 실행하고, 검증하는 코드는 Unity 패키지와 같은 파일을 쓴다. 두 벌을 만들지 않는다 -->
  <ItemGroup>
    <Compile Include="..\unity\Packages\com.qaplay.core\Runtime\Json.cs" Link="Shared\Json.cs" />
    <Compile Include="..\unity\Packages\com.qaplay.core\Runtime\RuleReader.cs" Link="Shared\RuleReader.cs" />
    <Compile Include="..\unity\Packages\com.qaplay.core\Runtime\RuleRunner.cs" Link="Shared\RuleRunner.cs" />
    <Compile Include="..\unity\Packages\com.qaplay.core\Runtime\RuleChecker.cs" Link="Shared\RuleChecker.cs" />
  </ItemGroup>
  <!-- 대시보드의 화면. 실행 파일 안에 넣어 둔다 -->
  <ItemGroup>
    <EmbeddedResource Include="Dashboard.html" LogicalName="Qaplay.Runner.Dashboard.html" />
  </ItemGroup>

  <!--
    코어는 외부 라이브러리(NuGet 패키지)를 쓰지 않는다. 연동은 선택 설치 모듈(modules/NAME)이고, 각자 자기 프로젝트와 라이브러리를 가진다.
    모듈은 러너가 실행될 때 bin/.../modules/NAME에서 읽는다(Modules.cs). 코어는 모듈을 참조하지 않는다
  -->
  <ItemGroup>
    <Compile Remove="modules\**" />
    <None Remove="modules\**" />
    <InternalsVisibleTo Include="qaplay.xlsx" />
    <InternalsVisibleTo Include="qaplay.google" />
  </ItemGroup>

  <!--
    dotnet build runner 한 번에 이 저장소의 모듈도 만들어 러너 옆 modules 폴더에 넣는다. 코어만 만들려면 -p:QaplayModules=false.
    모듈은 코어를 참조하므로, 코어를 다 만든 뒤에 코어를 다시 만들지 않게(BuildProjectReferences=false) 만든다
  -->
  <Target Name="BuildModules" AfterTargets="Build" Condition="'$(QaplayModules)' != 'false'">
    <ItemGroup>
      <QaplayModule Include="modules\*\*.csproj" />
    </ItemGroup>
    <MSBuild Projects="@(QaplayModule)" Targets="Restore" Properties="Configuration=$(Configuration);MSBuildRestoreSessionId=$([System.Guid]::NewGuid())" />
    <MSBuild Projects="@(QaplayModule)" Targets="Build" Properties="Configuration=$(Configuration);BuildProjectReferences=false" />
  </Target>

</Project>
