<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>qaplay</AssemblyName>
    <RootNamespace>Qaplay.Runner</RootNamespace>
    <Version>0.1.0</Version>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <!-- 규칙을 읽고, 실행하고, 검증하는 코드는 Unity 패키지와 같은 파일을 쓴다. 두 벌을 만들지 않는다 -->
  <ItemGroup>
    <Compile Include="..\unity\Packages\com.qaplay.core\Runtime\Json.cs" Link="Shared\Json.cs" />
    <Compile Include="..\unity\Packages\com.qaplay.core\Runtime\RuleReader.cs" Link="Shared\RuleReader.cs" />
    <Compile Include="..\unity\Packages\com.qaplay.core\Runtime\RuleRunner.cs" Link="Shared\RuleRunner.cs" />
    <Compile Include="..\unity\Packages\com.qaplay.core\Runtime\RuleChecker.cs" Link="Shared\RuleChecker.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.105.1" />
  </ItemGroup>

</Project>
